    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "prettier": "3.9.6",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
