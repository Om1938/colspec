{
  "name": "@colspec/core",
  "version": "0.1.1",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "build": "tsdown && tsx scripts/json-schema.ts",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./contract.schema.json": "./dist/contract.schema.json"
  },
  "description": "JSON contract schema, validation and function registries for dynamic TanStack Table definitions.",
  "author": "Om Prakash Das",
  "homepage": "https://github.com/Om1938/colspec/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Om1938/colspec/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Om1938/colspec.git",
    "directory": "packages/core"
  },
  "keywords": [
    "tanstack-table",
    "tanstack",
    "table",
    "datagrid",
    "dynamic-columns",
    "colspec",
    "json-schema zod validation"
  ]
}
