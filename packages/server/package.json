{
  "name": "@colspec/server",
  "version": "0.0.0",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "build": "tsdown",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@colspec/core": "workspace:*"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "description": "Store, version, publish and serve colspec table definitions from any database or Node.js framework.",
  "author": "Om Prakash Das",
  "homepage": "https://github.com/Om1938/colspec/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/Om1938/colspec/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Om1938/colspec.git",
    "directory": "packages/server"
  },
  "keywords": [
    "tanstack-table",
    "tanstack",
    "table",
    "datagrid",
    "dynamic-columns",
    "colspec",
    "backend persistence mongodb postgresql"
  ]
}
